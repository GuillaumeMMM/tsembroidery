{
  "name": "@guillaumemmm/tsembroidery",
  "version": "2.0.0",
  "description": "Read Brother .pes embroidery files and render them as SVG.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run build"
  },
  "author": "guillaumemmm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuillaumeMMM/tsembroidery.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@opencode/cli": "^2.0.15",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
